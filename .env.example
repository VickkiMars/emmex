# =============================================================================
# Emmanuel Healthcare Security Platform - Environment Configuration Template
# Copy this file to .env and adjust values for your deployment environment:
#   cp .env.example .env
# =============================================================================

# --- Backend Configuration ---
EMMANUEL_BACKEND_HOST=0.0.0.0
EMMANUEL_BACKEND_PORT=8005
EMMANUEL_DEBUG=False

# Database Connection (SQLite default, PostgreSQL compatible)
DATABASE_URL=sqlite:////app/data/emmanuel.db

# --- Frontend Configuration ---
FRONTEND_PORT=5174
VITE_API_URL=http://localhost:8005

# --- Security & Regulatory Safeguards ---
# Differential Privacy epsilon budget for Membership Inference Defense
DIFF_PRIVACY_EPSILON=1.0

# Zero Trust Role Based Access Control
ZERO_TRUST_ENFORCE_MFA=True
